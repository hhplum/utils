{
  "name": "@hhplum/utils-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "format": "prettier --write --cache .",
    "lint": "eslint --cache .",
    "typecheck": "tsc -p scripts --noEmit && pnpm -r --parallel run typecheck",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "vitest run",
    "release": "tsx scripts/release.ts",
    "ci:publish": "tsx scripts/publish.ts",
    "prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hhplum/release-scripts": "^1.1.2",
    "@hhplum/utils-browser": "workspace:^",
    "@hhplum/utils-global": "workspace:^",
    "@hhplum/utils-node": "workspace:^",
    "@hhplum/utils-test": "workspace:^",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.19.130",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.25.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-regexp": "^2.10.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rollup": "^4.40.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "simple-git-hooks": "^2.14.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm -r --parallel run prebuild && pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "prettier --write --cache --ignore-unknown"
    ],
    "packages/*/{src,types}/**/*.ts": [
      "eslint --cache --fix"
    ],
    "packages/**/*.d.ts": [
      "eslint --cache --fix"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
